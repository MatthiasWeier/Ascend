generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExerciseType {
  REPS   // reps + weight (e.g. bench press, pull-ups)
  HOLD   // static hold, time-based (e.g. plank, front lever)
}

enum MuscleFocus {
  PUSH
  PULL
  LEGS
  CORE
  GRIP
}

enum ClimbingStyle {
  BOULDER
  ROUTE
}

enum SetType {
  WARMUP
  NORMAL
  DROP
  FAILURE
}

enum WeightUnit {
  KG
  LBS
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  bodyWeightKg Float?
  // Display-only preference - every weight is still stored in kg
  // everywhere (workout sets, bodyweight history, CSV export/import,
  // group posts); this only controls what unit the UI shows/accepts.
  weightUnit   WeightUnit @default(KG)
  avatarUrl    String?
  // Set when the first-run tutorial was finished or skipped; null = show it.
  tutorialCompletedAt DateTime?
  // TOTP (RFC 6238) two-factor auth. totpSecret is set as soon as setup
  // starts but totpEnabled only flips to true once the user proves they
  // can generate a valid code with it - an unconfirmed secret has zero
  // effect on login. There's no email-based account recovery in this app
  // at all, so losing both the authenticator and backup codes means an
  // admin has to reset this from /dashboard/admin (see admin-auth route).
  totpSecret      String?
  totpEnabled     Boolean          @default(false)
  totpBackupCodes TotpBackupCode[]
  sessions        UserSession[]
  // Instance-wide admin (not a per-group role): can manage all users from
  // /dashboard/admin. Not derived from anything - explicitly set.
  isAdmin      Boolean  @default(false)
  // Secret used in the subscribable ICS calendar feed URL instead of a
  // login session - generated on first request, regenerable in Settings.
  calendarToken String? @unique
  // Bumped by a client-side heartbeat while the app is open (see
  // /api/heartbeat) - drives the "Online" / "zuletzt online vor X" label
  // on group member lists.
  lastActiveAt DateTime?
  createdAt    DateTime @default(now())

  workoutSessions   WorkoutSession[]
  workoutTemplates  WorkoutTemplate[]
  bodyWeightEntries BodyWeightEntry[]
  climbingSends     ClimbingSend[]
  balanceGoals      BalanceGoal[]
  groupMemberships  GroupMember[]
  ownedGroups       Group[]                 @relation("GroupOwner")
  groupPosts        GroupPost[]
  createdExercises  Exercise[]              @relation("ExerciseCreator")
  activatedDailies  GroupDailyChallenge[]   @relation("DailyChallengeActivator")
  challengeGoals    UserChallengeGoal[]
  yammerVotes       YammerVote[]
  createdGroupGoals GroupGoal[]             @relation("GroupGoalCreator")
  goalContributions GroupGoalContribution[]
  pushSubscriptions PushSubscription[]
  postReactions     PostReaction[]
  apiKeys           ApiKey[]
  notifications     Notification[]
  workoutDraft      WorkoutDraft?
  workoutPhotos     WorkoutPhoto[]
  postComments      PostComment[]
}

// Catalog of exercises. Seeded with defaults; users/groups can add their own.
model Exercise {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  type        ExerciseType
  focus       MuscleFocus
  // Bodyweight-based exercises (pull-ups, push-ups, dips, ...) get the
  // user's logged bodyweight folded into load/1RM/power calculations -
  // getting heavier makes the same reps objectively more work.
  isBodyweight Boolean     @default(false)
  isDefault    Boolean     @default(true)

  // null = global default. Set when a user or group creates a custom one.
  createdById String?
  createdBy   User?   @relation("ExerciseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  groupId     String?
  group       Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  sets              WorkoutSet[]
  templateEntries   WorkoutTemplateEntry[]
  challengeTemplate ChallengeTemplate?
  groupGoals        GroupGoal[]

  @@index([groupId])
}

model WorkoutSession {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @default(now())
  notes  String?

  // 1 (easy) - 10 (max effort) - the average of focusFatigue when that was
  // given, kept as its own column since overload detection and the
  // activity calendar only need a single per-session number.
  perceivedExertion Int?
  // 1 (fine) - 10 (skin destroyed) - relevant for climbers
  skinCondition     Int?

  sets WorkoutSet[]
  // Per-muscle-group fatigue (1-10), one row per focus actually trained in
  // this session - lets Workout Brain deprioritize a focus that was just
  // wrecked, not only one that was recently trained at all.
  focusFatigue WorkoutFocusFatigue[]

  // Group posts created via the "share this workout" / "share all workouts"
  // actions, so re-sharing can be detected and skipped.
  sharedPosts GroupPost[]
  photos      WorkoutPhoto[]

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WorkoutSet {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  order      Int

  // REPS-type exercises. For isBodyweight exercises, weightKg is *added*
  // weight (e.g. a dip belt) on top of bodyweight - can be 0/null.
  reps      Int?
  weightKg  Float?

  // HOLD-type exercises
  durationSec Int?

  // Warm-up sets don't count toward volume/PRs/weekly-set-count - they're
  // not working sets. Drop/Failure are purely informational tags.
  setType SetType @default(NORMAL)
  notes   String?

  @@index([sessionId])
  @@index([exerciseId])
}

// One row per muscle focus actually trained in a session - only those
// focuses get asked about, and only those get a rating.
model WorkoutFocusFatigue {
  id        String         @id @default(cuid())
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  focus     MuscleFocus
  // 1 (frisch) - 10 (komplett erschöpft)
  rating    Int

  @@unique([sessionId, focus])
  @@index([sessionId])
}

model WorkoutTemplate {
  id      String                  @id @default(cuid())
  userId  String
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  entries WorkoutTemplateEntry[]

  createdAt DateTime @default(now())
}

model WorkoutTemplateEntry {
  id         String          @id @default(cuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id])
  order      Int
  targetSets Int?
  targetReps Int?
}

// Bodyweight over time. Kept as a history (not just User.bodyWeightKg) so
// past workouts can be evaluated against the bodyweight at the time they
// happened, not today's.
model BodyWeightEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // German-calendar day (Europe/Berlin) as YYYY-MM-DD, one entry per day.
  dateKey  String
  weightKg Float
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
  @@index([userId, dateKey])
}

// A single completed boulder/route for the climbing pyramid. `count` lets
// one row represent "N sends of this grade" logged together (e.g. the
// boulder-day quick-counter: "5x 6", "3x 4").
model ClimbingSend {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime      @default(now())
  style    ClimbingStyle
  grade    String // e.g. "V5", "6a+", or plain German/Fontainebleau scale "6"
  attempts Int           @default(1)
  count    Int           @default(1)

  @@index([userId, date])
}

// User-defined target split for the balance radar chart, e.g. PUSH: 30, PULL: 40, LEGS: 20, CORE: 10
model BalanceGoal {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  focus         MuscleFocus
  targetPercent Float

  @@unique([userId, focus])
}

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique @default(cuid())
  ownerId    String
  // Deleting the owner's account deletes the group entirely (removing
  // everyone else too) - there's no ownership-transfer feature, so this is
  // the only well-defined behavior. Account-deletion UI warns about this.
  owner      User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  members         GroupMember[]
  posts           GroupPost[]
  customExercises Exercise[]
  dailyChallenges GroupDailyChallenge[]
  goals           GroupGoal[]
}

enum GroupRole {
  LEADER
  MEMBER
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  // When on, every new workout this member logs is auto-shared into this
  // group's feed - and turning it on backfills every past workout not
  // already shared here.
  autoShareWorkouts Boolean @default(false)

  @@unique([groupId, userId])
  @@index([userId])
}

enum PostType {
  PHOTO
  WORKOUT_SHARE
  TEXT
}

// Feed items inside a group: progress photos, shared workouts, text updates
model GroupPost {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PostType
  content   String? // caption / text body
  imageUrl  String? // for PHOTO posts
  createdAt DateTime @default(now())

  // Set for WORKOUT_SHARE posts - lets "share all workouts" skip ones
  // already shared into this group. Survives the source workout being
  // deleted later (the post's content already has its own static summary).
  workoutSessionId String?
  workoutSession   WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)

  reactions PostReaction[]
  comments  PostComment[]

  @@unique([groupId, workoutSessionId])
  @@index([groupId, createdAt])
}

// One reaction per user per post - picking a different emoji replaces the
// old one rather than adding a second, same as most chat apps.
model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// Catalog of daily-challenge "themes" a group leader can activate, e.g.
// "Pullup Maxing" tied to the Pull-ups exercise. Seeded like Exercise.
model ChallengeTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  exerciseId  String   @unique
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  isDefault   Boolean  @default(true)

  groupChallenges GroupDailyChallenge[]
}

// A challenge theme the leader has switched on for the group. Max 4 active
// per group, enforced in the API.
model GroupDailyChallenge {
  id                  String            @id @default(cuid())
  groupId             String
  group               Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  challengeTemplateId String
  challengeTemplate   ChallengeTemplate @relation(fields: [challengeTemplateId], references: [id])
  activatedById       String
  activatedBy         User              @relation("DailyChallengeActivator", fields: [activatedById], references: [id], onDelete: Cascade)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  // Optional fun stakes for the day, e.g. "Verlierer macht 20 Liegestütze" -
  // free text set by the leader on activation, shown to everyone.
  stakes              String?

  goals UserChallengeGoal[]

  @@unique([groupId, challengeTemplateId])
}

// One user's personal rep target for a group's active daily challenge.
// Evolves over time via post-challenge difficulty ratings.
model UserChallengeGoal {
  id                    String              @id @default(cuid())
  groupDailyChallengeId String
  groupDailyChallenge   GroupDailyChallenge @relation(fields: [groupDailyChallengeId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetReps            Int
  // Set once yammer votes cross the 75% threshold - blocks starting a new
  // attempt until the user raises their target.
  isInvalidated         Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  votes    YammerVote[]
  attempts DailyChallengeAttempt[]

  @@unique([groupDailyChallengeId, userId])
}

// A veto cast by another group member against a goal they think is
// sandbagged. The goal owner cannot vote on their own goal (enforced in API).
model YammerVote {
  id                  String            @id @default(cuid())
  userChallengeGoalId String
  userChallengeGoal   UserChallengeGoal @relation(fields: [userChallengeGoalId], references: [id], onDelete: Cascade)
  voterId             String
  voter               User              @relation(fields: [voterId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([userChallengeGoalId, voterId])
}

enum ChallengeAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ENDED_EARLY
}

// One day's execution of a user's challenge goal. `dateKey` is the
// German-calendar day so "today" always means Europe/Berlin, not UTC.
model DailyChallengeAttempt {
  id                  String                 @id @default(cuid())
  userChallengeGoalId String
  userChallengeGoal   UserChallengeGoal      @relation(fields: [userChallengeGoalId], references: [id], onDelete: Cascade)
  dateKey             String
  targetRepsSnapshot  Int
  // currentReps = manualReps (tapped in the challenge dialog) + workoutReps
  // (auto-counted from the day's logged workout sets of the same exercise).
  currentReps         Int                    @default(0)
  manualReps          Int                    @default(0)
  workoutReps         Int                    @default(0)
  status              ChallengeAttemptStatus @default(IN_PROGRESS)
  startedAt           DateTime               @default(now())
  completedAt         DateTime?
  // 1 (sehr einfach) .. 5 (sehr schwer) - required once >=50% of target is
  // reached or the attempt is ended early; adjusts the goal's future target.
  difficultyRating    Int?

  @@unique([userChallengeGoalId, dateKey])
}

// A shared group target everyone contributes to, e.g. "10.000 Liegestütze
// im September" - progress is the sum of every member's logged
// contributions, not tied to any single exercise or workout.
enum GoalUnit {
  REPS
  DURATION_SEC
  KM
  CUSTOM
}

model GroupGoal {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  unit        GoalUnit
  // Only meaningful (and required) when unit = CUSTOM, e.g. "Bahnen".
  customUnitLabel String?
  targetValue Float
  // Only contributions dated on/after startDate (and on/before deadline)
  // count - without it, linking an exercise would backfill and
  // auto-contribute the member's entire training history for it, not just
  // what happened during the goal's actual window (e.g. "1000 pull-ups in
  // October" pulling in September's reps too).
  startDate   DateTime?
  deadline    DateTime?

  // Optional link to an Exercise: when set, matching WorkoutSets and
  // completed DailyChallengeAttempts auto-contribute (see
  // lib/goal-contributions.ts) instead of requiring manual entry. Must
  // agree with `unit` (REPS exercise <-> REPS goal, HOLD <-> DURATION_SEC) -
  // enforced in the API, not here.
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  createdById String
  createdBy   User      @relation("GroupGoalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  contributions GroupGoalContribution[]

  @@index([groupId])
  @@index([exerciseId])
}

enum ContributionSource {
  MANUAL
  WORKOUT
  CHALLENGE
}

// One member's contribution toward a GroupGoal - either typed in by hand
// (MANUAL) or derived automatically from a WorkoutSet/DailyChallengeAttempt
// once the goal is linked to an exercise. `sourceId` + the unique
// constraint below make auto-contributions idempotent: the same workout
// set or challenge attempt can never double-count toward the same goal,
// even if the triggering request is retried.
model GroupGoalContribution {
  id        String             @id @default(cuid())
  goalId    String
  goal      GroupGoal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  source    ContributionSource @default(MANUAL)
  sourceId  String?
  createdAt DateTime           @default(now())

  @@unique([goalId, source, sourceId])
  @@index([goalId])
  @@index([userId])
}

// One browser/device's Web Push subscription. A user can have several
// (phone, laptop, ...) - each gets notified independently.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// One single-use TOTP recovery code, issued 10-at-a-time when 2FA is
// enabled (and again on regeneration). Hashed like ApiKey.keyHash - the
// plaintext is shown exactly once, at generation time.
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Tracks one active JWT ("Sitzung") so it can be individually revoked -
// see the jwt() callback in lib/auth.ts for how a JWT that's otherwise
// self-contained gets checked against this table on every request.
// Deleting a row (Settings -> Sitzungen, or an admin action) signs that
// device out on its very next request, without waiting for the JWT to
// naturally expire.
model UserSession {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// A personal access token for the /api/v1/* REST API - own scripts/
// automations, not third-party OAuth apps. Only the SHA-256 hash is
// stored (a straight hash is fine here, unlike passwords: the key itself
// is already a high-entropy random secret, not something to defend
// against low-entropy guessing); the raw key is shown exactly once, at
// creation time.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// A comment (or reply, via parentId) under a group post - Reddit-style
// threads. A deleted comment that still has replies is kept as a stub
// (deletedAt set, content cleared) so the thread stays readable.
model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      GroupPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  content   String
  createdAt DateTime      @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@index([parentId])
}

// One entry in a user's in-app notification list (the bell). Text is not
// stored - only who/what/where - so it renders in the viewer's language.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  actorName String
  groupName String
  snippet   String?
  url       String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

// The in-progress "log workout" form, saved server-side (one per user) so a
// phone killing the browser tab in the background doesn't lose the entry.
// `data` is the client's own form snapshot - opaque to the server.
model WorkoutDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

// A "pump pic" attached to a workout. sessionId is null while the photo is
// only part of an unsaved draft; it's attached when the workout is saved.
model WorkoutPhoto {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filename  String
  createdAt DateTime        @default(now())

  @@index([sessionId])
  @@index([userId, sessionId])
}
