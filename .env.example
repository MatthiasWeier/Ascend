DATABASE_URL="postgresql://ascend:ascend@localhost:5432/ascend"
AUTH_SECRET="generate-with-openssl-rand-base64-33"

# Required if you're behind a reverse proxy / accessing via anything other
# than plain localhost (see docker-compose.yml, which sets this for you).
# AUTH_TRUST_HOST="true"

# --- Legal pages (/impressum, /datenschutz) ---
# Ascend is self-hosted: whoever runs an instance is the data controller for
# it and is legally responsible for these pages (Impressumspflicht per § 5
# DDG in Germany, GDPR data-controller obligations more broadly). Leave
# unset and the pages will clearly say "not configured" instead of showing
# fake data - fill these in before letting real users sign up.
# OPERATOR_NAME="Jane Doe"
# OPERATOR_ADDRESS="Musterstraße 1, 12345 Musterstadt, Germany"
# OPERATOR_EMAIL="contact@example.com"
# OPERATOR_PHONE="+49 30 12345678"
